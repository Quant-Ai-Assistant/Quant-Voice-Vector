{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quant Voice Vector",
  "identifier": "ai.quant.voicevector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quant Voice Vector",
        "width": 980,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "resources": {
      "../models/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx": "models/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx",
      "../models/silero_vad.onnx": "models/silero_vad.onnx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "licenseFile": "../LICENSE"
  }
}
